<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Every package ships in lockstep. A release's version comes from its tag (v*); this is only a local default. -->
    <Version>0.0.1-dev</Version>
    <Authors>rkingon</Authors>
    <Copyright>Copyright (c) rkingon</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rkingon/Levee</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rkingon/Levee</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ddd;hexagonal;operations;postgres;rls;oxbow;analyzers;mcp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!--
    The package's README is read on nuget.org, where the repository's relative docs/ links lead nowhere: packed with each
    pointing at the same page on the site.
  -->
  <Target Name="_LeveePackedReadme" BeforeTargets="_GetPackageFiles" Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_LeveeReadme>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)README.md'))</_LeveeReadme>
      <_LeveeReadme>$([System.Text.RegularExpressions.Regex]::Replace($(_LeveeReadme), '\]\(docs/([a-z0-9-]+)\.md', '](https://rkingon.github.io/Levee/$1/'))</_LeveeReadme>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)README.md" Lines="$([MSBuild]::Escape($(_LeveeReadme)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
