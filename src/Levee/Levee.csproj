<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Platforms whose rules hold by construction: a catalog of declared operations, one pipeline, and analyzers that fail the build on wrong code.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Levee's own projections ask the dispatcher what a client mustn't: a scope pinned from earlier, a stream's opening. -->
    <InternalsVisibleTo Include="Levee.AspNetCore" />
    <InternalsVisibleTo Include="Levee.Oxbow" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- The generator and analyzers ship inside this package, so every project that references Levee runs them. -->
    <ProjectReference Include="../Levee.Analyzers/Levee.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Levee.Analyzers/bin/$(Configuration)/netstandard2.0/Levee.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build/Levee.props" Pack="true" PackagePath="buildTransitive/Levee.props" />
    <None Include="build/Levee.targets" Pack="true" PackagePath="buildTransitive/Levee.targets" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
