<Project>
  <!--
    An .editorconfig value ends at its first ';', so the semicolon list MSBuild users write would keep only its first entry.
    Rewritten to commas just before the analyzers' config is generated, after the project has set it.
  -->
  <Target Name="_LeveeNormalizeAllowedReferences" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun" Condition="'$(LeveeAllowedReferences)' != ''">
    <PropertyGroup>
      <LeveeAllowedReferences>$(LeveeAllowedReferences.Replace(';', ','))</LeveeAllowedReferences>
    </PropertyGroup>
  </Target>

  <!--
    The rules are the build's: a project that turns its analyzers off, or leaves Levee's out, has none of them, with no reason
    beside the code. dotnet levee check compiles once without them on purpose (LeveeCheck), then analyzes every project.
  -->
  <!--
    An IDE's design-time pass compiles nothing (SkipCompilerExecution), so it's spared. check's own pass is recognised by a
    token it passes as a property and in its environment: the environment is read directly, since a project file can set a
    property of any name, but no process's environment.
  -->
  <Target Name="_LeveeRulesRun" BeforeTargets="CoreCompile"
          Condition="'$(LeveeRole)' != '' and '$(SkipCompilerExecution)' != 'true' and !('$(LeveeCheck)' != '' and '$(LeveeCheck)' == '$([System.Environment]::GetEnvironmentVariable(`LEVEE_CHECK_TOKEN`))')">
    <ItemGroup>
      <_LeveeTestFramework Include="@(PackageReference)" Condition="'%(Identity)' == 'Microsoft.NET.Test.Sdk' or '%(Identity)' == 'Microsoft.Testing.Platform' or '%(Identity)' == 'xunit' or '%(Identity)' == 'xunit.v3' or '%(Identity)' == 'xunit.v3.core' or '%(Identity)' == 'MSTest' or '%(Identity)' == 'MSTest.TestFramework' or '%(Identity)' == 'NUnit' or '%(Identity)' == 'TUnit' or '%(Identity)' == 'TUnit.Core'" />
      <!-- A global config of the project's own can set the role the analyzers read, over the one MSBuild gives them. -->
      <_LeveeConfig Include="@(GlobalAnalyzerConfigFiles);@(EditorConfigFiles)" Exclude="$(GeneratedMSBuildEditorConfigFile)" />
    </ItemGroup>
    <ReadLinesFromFile File="%(_LeveeConfig.FullPath)" Condition="Exists('%(_LeveeConfig.FullPath)')">
      <Output TaskParameter="Lines" ItemName="_LeveeConfigLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_LeveeConfigOverride Include="@(_LeveeConfigLine)" Condition="$([System.String]::Copy('%(Identity)').Trim().ToLowerInvariant().StartsWith('build_property.levee'))" />
    </ItemGroup>
    <Error Code="LEVEE006" Condition="'$(LeveeRole)' == 'Test' and ('$(IsTestProject)' != 'true' or '@(_LeveeTestFramework)' == '')"
           Text="This project's role is Test, which the code rules don't hold, but it isn't a test project. Fix: give it the role it is; a test project sets IsTestProject and references a test framework (Microsoft.NET.Test.Sdk, xunit.v3, MSTest, NUnit, TUnit) (dotnet levee explain LEVEE006)" />
    <Error Code="LEVEE006" Condition="'$(RunAnalyzers)' == 'false' or '$(RunAnalyzersDuringBuild)' == 'false'"
           Text="This project turns its analyzers off (RunAnalyzers or RunAnalyzersDuringBuild), and every Levee rule with them. Fix: remove the property; suppress one rule beside the code, with a reason (dotnet levee explain LEVEE006)" />
    <Error Code="LEVEE006" Condition="'@(_LeveeConfigOverride)' != ''"
           Text="An analyzer config file sets what Levee's analyzers read from MSBuild (@(_LeveeConfigOverride->'%(Identity)', ', ')), over the project's own properties. Fix: remove those lines; set LeveeRole and the rest in the project file (dotnet levee explain LEVEE006)" />
    <Error Code="LEVEE009" Condition="'@(Analyzer->AnyHaveMetadataValue(`Filename`, `Levee.Analyzers`))' != 'true'"
           Text="This project uses Levee without its analyzers, so none of its rules run here. Fix: reference Levee without ExcludeAssets or PrivateAssets naming analyzers (dotnet levee explain LEVEE009)" />
  </Target>

  <!-- dotnet levee check reads what each compilation suppressed from its error log: one per project and target framework. -->
  <PropertyGroup Condition="'$(LeveeCheckLogs)' != ''">
    <ErrorLog>$(LeveeCheckLogs)/$(MSBuildProjectName)~$(TargetFramework).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <!-- What a referencing project asks of this one: its role. A project without Levee has no such target. -->
  <Target Name="LeveeRoleOf" Returns="@(_LeveeRoleOf)">
    <ItemGroup>
      <_LeveeRoleOf Include="$(MSBuildProjectFullPath)" Role="$(LeveeRole)" />
    </ItemGroup>
  </Target>

  <!--
    Every project a Levee project references uses Levee too, with a role: one outside it escapes every rule, and becomes a
    side door (adapters sharing code, a package admitted into Application). A test may reference anything.
  -->
  <Target Name="_LeveeEveryProjectHasARole" AfterTargets="ResolveProjectReferences"
          Condition="'$(LeveeRole)' != '' and '$(LeveeRole)' != 'Test' and '$(LeveeRole)' != 'TestSupport' and '@(_MSBuildProjectReferenceExistent)' != ''">
    <ItemGroup>
      <_LeveeReferenced Include="@(_MSBuildProjectReferenceExistent)"
                        Condition="'%(_MSBuildProjectReferenceExistent.ReferenceOutputAssembly)' != 'false' and '%(_MSBuildProjectReferenceExistent.OutputItemType)' == ''" />
    </ItemGroup>
    <MSBuild Projects="@(_LeveeReferenced)" Targets="LeveeRoleOf" SkipNonexistentTargets="true" BuildInParallel="$(BuildInParallel)"
             Properties="%(_LeveeReferenced.SetConfiguration);%(_LeveeReferenced.SetPlatform);%(_LeveeReferenced.SetTargetFramework)"
             RemoveProperties="%(_LeveeReferenced.GlobalPropertiesToRemove);%(_LeveeReferenced.UndefineProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_LeveeRoled" />
    </MSBuild>
    <ItemGroup>
      <_LeveeUnroled Include="@(_LeveeReferenced->'%(FullPath)')" Exclude="@(_LeveeRoled)" />
    </ItemGroup>
    <Error Code="LEVEE001" Condition="'@(_LeveeUnroled)' != ''"
           Text="This $(LeveeRole) project references @(_LeveeUnroled->'%(Filename)', ', '), which doesn't use Levee, so none of Levee's rules hold there. Fix: reference Levee from it and give it a role: Infrastructure for code adapters share, Kernel for ids and values every layer shares (dotnet levee explain LEVEE001)" />
  </Target>
</Project>
